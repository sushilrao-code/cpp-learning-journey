//!Increment & Decrement
#include <iostream>
using namespace std;
int main(){
     float a,b,c,d;
    cout<<"Enter your Value A = ";
    cin>>a;
      cout<<"Enter your Value B = ";
    cin>>b;
     cout<<"Enter your Value C = ";
    cin>>c;
      cout<<"Enter your Value D = ";
    cin>>d;
    a ++;
    b --;
    --c;
    ++d;
    cout<< a <<"\n" << b <<"\n";
    cout<< c <<"\n" << d;

    
    return 0;
}